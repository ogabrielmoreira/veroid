{
  "name": "vero-id",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vero ID — plataforma white-label de KYC, prova de vida e qualificação de clientes (protótipo de portfólio).",
  "author": "Gabriel Moreira <https://gabrielmoreira.tech>",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').renameSync('dist/veroid/_headers','dist/_headers')\"",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "predev": "node scripts/prepare-mediapipe.mjs",
    "prebuild": "node scripts/prepare-mediapipe.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "papaparse": "^5.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  }
}
