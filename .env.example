# ---------------------------------------------------------------
# Front-end (vai para o bundle público — só valores públicos aqui)
# Copie para .env.local e preencha.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://ajhfysjgaqduomkmkeec.supabase.co
# Chave "publishable" (antiga "anon"). É pública por design; a proteção é o RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Opcional (fase 1 funciona sem): widget do Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=
# true = todo login pede código por e-mail (exige SMTP próprio com {{ .Token }} nos templates)
VITE_LOGIN_EMAIL_OTP=false

# ---------------------------------------------------------------
# Worker (NUNCA com prefixo VITE_). Em produção: `wrangler secret put <NOME>`.
# Em dev local: arquivo .dev.vars (ignorado pelo git).
# ---------------------------------------------------------------
# SUPABASE_SECRET_KEY=sb_secret_...
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# TURNSTILE_SECRET=
